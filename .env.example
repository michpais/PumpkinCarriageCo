# Synthetic demo. No Etsy credentials are needed or consumed.
PCC_DATABASE_URL=sqlite:///data/demo.sqlite3
PCC_SHOP_ID=synthetic-demo

# Separate local statement database; choose an internal identifier before importing.
# This identifier need not be the numeric Etsy shop ID.
PCC_STATEMENTS_DATABASE_URL=sqlite:///data/shop.sqlite3
PCC_STATEMENTS_SHOP_ID=

# Optional. Blank uses <your home>/Documents/PumpkinCarriageCo-Backups, outside Git.
PCC_STATEMENTS_BACKUP_DIR=
